# ─── Database ───
DATABASE_URL=sqlite:///./preppilot.db
# For MySQL (Docker): DATABASE_URL=mysql+pymysql://preppilot:preppilot@db:3306/preppilot

# ─── JWT ───
JWT_SECRET_KEY=change-me-to-a-very-long-random-string-at-least-32-chars
JWT_ALGORITHM=HS256
JWT_EXPIRATION_MINUTES=1440

# ─── App ───
FRONTEND_BASE_URL=http://127.0.0.1:8000
ALLOWED_ORIGINS=http://127.0.0.1:8000,http://localhost:8000
UPLOAD_DIR=uploads
SEED_DEMO_DATA=true

# ─── Google Gemini AI ───
GEMINI_API_KEY=your-gemini-api-key-here

# ─── SMTP (optional, for email verification/reset) ───
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_EMAIL=noreply@preppilot.local
